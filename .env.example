# Every secret / variable name used by GridCast (BUILD_PLAN §8.2).
# ci.yml checks that every secrets.X / vars.X referenced in .github/workflows appears here.
# Copy to .env for local runs. Never commit real values.

# --- Database (Neon) ---
DATABASE_URL=                 # pooled, sslmode=require; all jobs
DATABASE_URL_DIRECT=          # non-pooled; Alembic / pg_dump / VACUUM only
DATABASE_URL_RO=              # role gridcast_api_ro, pooled; API runtime only
NEON_API_KEY=

# --- Object store (S3-compatible: R2 or B2) ---
OBJSTORE_ENDPOINT_URL=
OBJSTORE_REGION=
OBJSTORE_ACCESS_KEY_ID=
OBJSTORE_SECRET_ACCESS_KEY=
OBJSTORE_RO_ACCESS_KEY_ID=
OBJSTORE_RO_SECRET_ACCESS_KEY=
OBJSTORE_BUCKET_PRIVATE=gridcast-artifacts
OBJSTORE_BUCKET_PUBLIC=gridcast-public

# --- MLflow (DagsHub) ---
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Healthchecks.io (optional; unset = no heartbeat) ---
HEALTHCHECKS_HOURLY_URL=
HEALTHCHECKS_DAILY_URL=
HEALTHCHECKS_API_URL=
HEALTHCHECKS_RETRAIN_URL=
HEALTHCHECKS_GATE_URL=
HEALTHCHECKS_KEEPALIVE_URL=
HEALTHCHECKS_PRUNE_URL=
HC_SECTIONS_URL=
HC_SECTIONS_REFRESH_URL=

# --- Azure (deploy) ---
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=gridcast-rg
AZURE_CONTAINERAPP_NAME=

# --- Cloudflare (fallback host, Pages) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DEMO_DATA_BASE_URL=
PUBLIC_API_URL=                # repository VARIABLE: the Worker base URL; enables the hourly API probe

# --- Optional ---
DISCORD_WEBHOOK_URL=

# --- Runtime ---
GRIDCAST_ENV=dev
OPENMETEO_USER_AGENT="gridcast (github.com/hamzaziouine/gridcast)"
